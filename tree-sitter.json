{
  "grammars": [
    {
      "name": "giovi",
      "camelcase": "Giovi",
      "scope": "source.giovi",
      "path": ".",
      "file-types": [
        "giovi"
      ],
      "highlights": "queries/highlights.scm",
      "tags": "queries/tags.scm",
      "injection-regex": "^giovi$"
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT",
    "description": "Giovi grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/simonvic/tree-sitter-giovi"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
